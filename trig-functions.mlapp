classdef TRIG_FUNC < matlab.apps.AppBase

    % Properties that correspond to app components
    properties (Access = public)
        UIFigure                     matlab.ui.Figure
        Menu                         matlab.ui.container.Menu
        LessonModeMenu               matlab.ui.container.Menu
        PythagoreanTheoremMenu       matlab.ui.container.Menu
        PracticeModeMenu             matlab.ui.container.Menu
        QuizModeLabel                matlab.ui.control.Label
        tanEditField                 matlab.ui.control.NumericEditField
        tanEditFieldLabel            matlab.ui.control.Label
        Button_9                     matlab.ui.control.Button
        cosEditField                 matlab.ui.control.NumericEditField
        cosEditFieldLabel            matlab.ui.control.Label
        Button_8                     matlab.ui.control.Button
        sinEditField                 matlab.ui.control.NumericEditField
        sinEditFieldLabel            matlab.ui.control.Label
        Button_7                     matlab.ui.control.Button
        CHEATSHEETButton             matlab.ui.control.Button
        CheatSheet                   matlab.ui.container.Panel
        Image2                       matlab.ui.control.Image
        NOTESLabel_4                 matlab.ui.control.Label
        NOTESLabel_3                 matlab.ui.control.Label
        AngleEditField               matlab.ui.control.NumericEditField
        adjEditField                 matlab.ui.control.NumericEditField
        oppEditField                 matlab.ui.control.NumericEditField
        DrawRightTriangleButton      matlab.ui.control.Button
        PLAYGROUNDLabel              matlab.ui.control.Label
        Image                        matlab.ui.control.Image
        HypotenuseEditField          matlab.ui.control.NumericEditField
        HypotenuseEditFieldLabel     matlab.ui.control.Label
        Button_6                     matlab.ui.control.Button
        AngleSlider                  matlab.ui.control.Slider
        AngleLabel                   matlab.ui.control.Label
        AdjacentSlider               matlab.ui.control.Slider
        AdjacentSliderLabel          matlab.ui.control.Label
        Button_4                     matlab.ui.control.Button
        Button_3                     matlab.ui.control.Button
        Button                       matlab.ui.control.Button
        OppositeSlider               matlab.ui.control.Slider
        OppositeSliderLabel          matlab.ui.control.Label
        Button_2                     matlab.ui.control.Button
        TRIGONOMETRICFUNCTIONSLabel  matlab.ui.control.Label
        UIAxes                       matlab.ui.control.UIAxes
    end

    
    methods (Access = private)
        function updateTriangle(app, oppVal, adjVal)
            sF = 2.5; % image scaling
            
            % Use passed-in slider values instead of reading from UI components
            opp = oppVal * sF;
            adj = adjVal * sF;
            
            hyp = sqrt(opp^2 + adj^2);
            
            % Calculate angles
            angle = atand(opp / adj);
            
            % Update angle sliders and hypotenuse field
            app.AngleSlider.Value = angle;

            app.HypotenuseEditField.Enable = "off";
            app.oppEditField.Enable = "off";
            app.adjEditField.Enable = "off";
       
            app.AngleEditField.Enable = "off";
            

            app.HypotenuseEditField.Value = round(hyp / sF, 2);

            app.oppEditField.Value = oppVal;
            app.adjEditField.Value = adjVal;

            app.AngleEditField.Value = angle;

            app.sinEditField.Value = sind(angle);
            app.cosEditField.Value = cosd(angle);
            app.tanEditField.Value = tand(angle);
           
            
            % Clear and redraw the triangle
            cla(app.UIAxes)
            hold(app.UIAxes, 'on')

           % --------------------------DRAW AND LABEL----------------------------%

            % Font settings for labels
            labelFont = 'Yuanti SC';
            labelSize = 24;
            paddingX = 1;
            paddingY = 1;

            
            % Plot side A (vertical)
            plot(app.UIAxes, [0 0], [0 opp], 'LineWidth', 3, 'Color', '#37a771')
            
            % Plot side B (horizontal)
            plot(app.UIAxes, [0 adj], [0 0], 'LineWidth', 3, 'Color', '#f7b11a')
            
            % Plot hypotenuse (side C)
            plot(app.UIAxes, [adj 0], [0 opp], 'LineWidth', 3, 'Color', '#7f6ff2')
            
            % Plot vertices with markers
            plot(app.UIAxes, [0 adj 0], [0 0 opp], 'o', 'MarkerSize', 6, 'MarkerFaceColor', '#555555')
            

            % Coordinates of vertices
            
            vertexB = [adj, 0];     % Bottom-right
            
            
            % Add text labels
            
            text(app.UIAxes, vertexB(1), vertexB(2), 'θ', ...
                'FontSize', 24, 'FontName', labelFont, ...
                'Color', 'black', 'HorizontalAlignment', 'left', 'VerticalAlignment', 'top');
            
            
            
               axis(app.UIAxes, 'equal');
                padding = 3;
                maxX = adj + padding;
                maxY = opp + padding;
                xlim(app.UIAxes, [-padding, max(maxX, 10)]);
                ylim(app.UIAxes, [-padding, max(maxY, 10)]);
                grid(app.UIAxes, 'on');
                app.UIAxes.Box = 'on';
                app.UIAxes.XColor = [0.3 0.3 0.3];
                app.UIAxes.YColor = [0.3 0.3 0.3];
                app.UIAxes.Color = [1 1 1];
            
            
            % Label Side A (vertical)
            midAC = [0, opp/2];
            text(app.UIAxes, midAC(1) - paddingX, midAC(2), 'opp   ', ...
                'FontSize', labelSize, 'FontName', labelFont, ...
                'Color', '#37a771', 'HorizontalAlignment', 'center')
            
            % Label Side B (horizontal)
            midAB = [adj/2, 0];
            text(app.UIAxes, midAB(1), midAB(2) - paddingX, 'adj', ...
                'FontSize', labelSize, 'FontName', labelFont, ...
                'Color', '#f7b11a', 'HorizontalAlignment', 'center')
            
            % Label Side C (hypotenuse)
            midBC = [adj/2, opp/2];
            text(app.UIAxes, midBC(1) + paddingX, midBC(2) + paddingY, '   hyp', ...
                'FontSize', labelSize, 'FontName', labelFont, ...
                'Color', '#7f6ff2', 'HorizontalAlignment', 'center')
        end

        
        

    end


        methods (Access = private)

        % Create UIFigure and components 
    end

    methods (Access = private)
        % Startup function runs right after UI components are created, before user sees app
    end
    

    % Callbacks that handle component events
    methods (Access = private)

        % Value changed function: OppositeSlider
        function OppositeSliderValueChanged(app, event)
           app.AdjacentSlider.Enable = "on"; 
           app.AngleSlider.Enable = "on";
           

        end

        % Value changing function: AdjacentSlider
        function AdjacentSliderValueChanging(app, event)
            % only lets user change SIDE B component at a time
            app.OppositeSlider.Enable = "off"; 
            app.AngleSlider.Enable = "off";
            
            
            app.updateTriangle(app.OppositeSlider.Value, event.Value);
            
        end

        % Value changing function: OppositeSlider
        function OppositeSliderValueChanging(app, event)
            % only lets user change SIDE A component at a time
            app.AdjacentSlider.Enable = "off"; 
            app.AngleSlider.Enable = "off";
            
            
            app.updateTriangle(event.Value, app.AdjacentSlider.Value);
            
        end

        % Value changed function: AdjacentSlider
        function AdjacentSliderValueChanged(app, event)
           app.OppositeSlider.Enable = "on"; 
           app.AngleSlider.Enable = "on";
           
        end

        % Value changing function: AngleSlider
        function AngleSliderValueChanging(app, event)
            % Disable other sliders
            app.OppositeSlider.Enable = "off";
            app.AdjacentSlider.Enable = "off";
        
        
            % Get the new angleA
            angleA = event.Value;
        
            % Define base unit side and scale factor
            sideA = app.OppositeSlider.Value;
        
            % Calculate sideB
            sideB = sideA / tand(angleA);
        
            % Scale both sides for visibility
        
            % Update the triangle drawing
            app.updateTriangle(sideA, sideB);

            app.OppositeSlider.Enable = "on";
            app.AdjacentSlider.Enable = "on";
            

            
        end

        % Button pushed function: DrawRightTriangleButton
        function DrawRightTriangleButtonPushed(app, event)
            app.OppositeSlider.Value = 3;
            app.AdjacentSlider.Value = 4;
            app.updateTriangle(3,4);
        end

        % Button pushed function: CHEATSHEETButton
        function CHEATSHEETButtonPushed(app, event)
            if strcmp(app.CheatSheet.Visible, "on")
                % close 
                app.CheatSheet.Visible = "off";
                
            else
    
                % open 
                app.CheatSheet.Visible = "on";
               
            end
        end

        % Value changed function: AngleSlider
        function AngleSliderValueChanged(app, event)
            app.OppositeSlider.Enable = "on";
            app.AdjacentSlider.Enable = "on";
            
        end

        % Menu selected function: PythagoreanTheoremMenu
        function PythagoreanTheoremMenuSelected(app, event)
            app.QuizModeLabel.Text = ' Taking you to Lesson Mode: Pythagorean Theorem... 📚';
            app.QuizModeLabel.BackgroundColor = [0.96 0.47 0.16];
            pause(2.0);
            app.QuizModeLabel.Text = '';
          
            TRIGLESSON();

            delete(app);
        end

        % Menu selected function: PracticeModeMenu
        function PracticeModeMenuSelected(app, event)
            app.QuizModeLabel.Text = ' Taking you to Practice Mode... 📝';
            app.QuizModeLabel.BackgroundColor = [0.96 0.47 0.16];
            pause(2.0);
            app.QuizModeLabel.Text = '';
          
            TRIGQUIZ();

            delete(app);
        end
    end

