            app.tanEditFieldLabel = uilabel(app.UIFigure);
            app.tanEditFieldLabel.HorizontalAlignment = 'right';
            app.tanEditFieldLabel.FontName = 'Yuanti SC';
            app.tanEditFieldLabel.FontSize = 24;
            app.tanEditFieldLabel.FontWeight = 'bold';
            app.tanEditFieldLabel.FontColor = [1 1 1];
            app.tanEditFieldLabel.Position = [600 88 77 32];
            app.tanEditFieldLabel.Text = 'tan (θ)';

            % Create tanEditField
            app.tanEditField = uieditfield(app.UIFigure, 'numeric');
            app.tanEditField.Editable = 'off';
            app.tanEditField.FontName = 'Yuanti SC';
            app.tanEditField.FontSize = 24;
            app.tanEditField.FontWeight = 'bold';
            app.tanEditField.FontColor = [0.302 0.2824 0.2824];
            app.tanEditField.Position = [715 83 110 32];

            % Create QuizModeLabel
            app.QuizModeLabel = uilabel(app.UIFigure);
            app.QuizModeLabel.HorizontalAlignment = 'center';
            app.QuizModeLabel.FontName = 'Yuanti SC';
            app.QuizModeLabel.FontSize = 24;
            app.QuizModeLabel.FontWeight = 'bold';
            app.QuizModeLabel.FontAngle = 'italic';
            app.QuizModeLabel.FontColor = [1 0.9098 0.3882];
            app.QuizModeLabel.Position = [401 378 514 147];
            app.QuizModeLabel.Text = '';

            % Show the figure after all components are created
            app.UIFigure.Visible = 'on';
        end
    end

    % App creation and deletion
    methods (Access = public)

        % Construct app
        function app = TRIG_FUNC

            % Create UIFigure and components
            createComponents(app)

            % Register the app with App Designer
            registerApp(app, app.UIFigure)

            if nargout == 0
                clear app
            end
        end

        % Code that executes before app deletion
        function delete(app)

            % Delete UIFigure when app is deleted
            delete(app.UIFigure)
        end
    end
end
