            % Create HintDisp_mini2
            app.HintDisp_mini2 = uilabel(app.UIFigure);
            app.HintDisp_mini2.HorizontalAlignment = 'center';
            app.HintDisp_mini2.WordWrap = 'on';
            app.HintDisp_mini2.FontName = 'Yuanti SC';
