classdef TRIGQUIZ < matlab.apps.AppBase

    % Properties that correspond to app components
    properties (Access = public)
        UIFigure                    matlab.ui.Figure
        Menu                        matlab.ui.container.Menu
        LessonModeMenu              matlab.ui.container.Menu
        PythagoreanTheoremMenu      matlab.ui.container.Menu
        TrigonometricFunctionsMenu  matlab.ui.container.Menu
        LampLabel                   matlab.ui.control.Label
        RightLamp                   matlab.ui.control.Lamp
        MiddleLap                   matlab.ui.control.Lamp
        LeftLamp                    matlab.ui.control.Lamp
        CheckAnswer                 matlab.ui.control.Button
        HintDisp_mini2              matlab.ui.control.Label
        HintDisp_mini1              matlab.ui.control.Label
        HintDispMain                matlab.ui.control.Label
        Hint                        matlab.ui.control.Button
        ShowSolution                matlab.ui.control.Button
        Next                        matlab.ui.control.Button
        Previous                    matlab.ui.control.Button
        Image                       matlab.ui.control.Image
        Exit                        matlab.ui.control.Button
        MODELabel                   matlab.ui.control.Label
        Button                      matlab.ui.control.Button
        QuestionPanel               matlab.ui.container.Panel
        CurrQ                       matlab.ui.control.Label
        EnterYourAnswerEditFieldLabel_2  matlab.ui.control.Label
        Feedback                    matlab.ui.control.Label
        SolutionPanel               matlab.ui.container.Panel
        ExplainTxt                  matlab.ui.control.Label
        Answer                      matlab.ui.control.Label
        Explanation                 matlab.ui.control.Label
        AnswerLabel                 matlab.ui.control.Label
        SolLabel                    matlab.ui.control.Label
        CurrImage                   matlab.ui.control.Image
        UserAnswer                  matlab.ui.control.EditField
        LivesLostPanel              matlab.ui.container.Panel
        LessonButton                matlab.ui.control.Button
        RestartButton               matlab.ui.control.Button
        UhOh                        matlab.ui.control.Label
        Panel                       matlab.ui.container.Panel
        BEGINButton                 matlab.ui.control.Button
        NOTESLabel                  matlab.ui.control.Label
    end

    
    properties (Access = public)

    LivesLeft= 3; 
    

    end
    
    properties (Access = private)
       QuestionBank table
       CurrQi=1;
    end

   methods (Access = private)

        % Create UIFigure and components 
        
      
        
        function loseLife(app) % TAKE CARE OF LIVES

            if app.LivesLeft > 0

                app.LivesLeft = app.LivesLeft - 1;
        
                switch app.LivesLeft

                    case 2
                        app.RightLamp.Color = [0.81,0.82,0.87]; % gray
                    case 1
                        app.MiddleLap.Color = [0.81,0.82,0.87];
                    case 0
                        app.LeftLamp.Color = [0.81,0.82,0.87];
                     
                end
            end
            if app.LivesLeft == 0 
                app.LivesLostPanel.Visible="on";
                uistack(app.LivesLostPanel, 'top');
            end
        end
        
      
        function qBank(app)
            
            app.QuestionBank = table( ...
            { ...
                '1. If Side AB is 6 and Side BC is 8, what is Side AC?'; ...
                '2. What is the sum of all internal angles in any triangle?'; ...
                '3. If angle A is 30° and the hypotenuse is 10, what is the length of the side opposite A?'; ...
                '4. The opposite side is 3 and hypotenuse is 5. What is sin(θ)?'; ...
                '5. If angle θ increases in a right triangle, what happens to the length of the opposite side (assuming hypotenuse stays the same)? Enter INC / DEC'; ...
                '6. Which trig function compares opposite and adjacent sides? Enter sin/cos/tan'; ...
                '7. If sin(θ) = 0.6 and the hypotenuse is 5, what’s the opposite side?'; ...
            }, ...
            { ...
                '1.png'; ...
                '2.png'; ...
                '3.png'; ...
                '4.png'; ...
                '5.png'; ...
                '6.png'; ...
                '7.png'; ...
            }, ...
            { ...
                '10'; ...
                '180'; ...
                '5'; ...
                '0.6'; ...
                'INC'; ...
                'tan'; ...
                '3'; ...
            }, ...
            { ...
                'Use the Pythagorean Theorem: √(6² + 8²) = √(36 + 64) = √100 = 10'; ...
                'Always 180°—it’s like triangle law of gravity! 🍎'; ...
                'sin(30°) = 0.5, and 0.5 × 10 = 5'; ...
                'sin(θ) = opposite / hypotenuse = 3 / 5 = 0.6'; ...
                'In a right triangle: sin(θ) = opposite / hypotenuse. If the hypotenuse stays the same and θ increases, sine increases — so the opposite side must get longer.'; ...
                'Both sets follow the same ratio: divide each by 2, they match!'; ...
                'They’re exactly the same size and shape—perfect match!'; ...
            }, ...
            { ...
                '  It''s a right triangle! Which rule do we use? 📐  '; ...
                '  Think of slicing a triangle into smaller angles—they always add up to the same! 🍕  '; ...
                '  Remember SOH-CAH-TOA! 🧠  '; ...
                '  Remember SOH-CAH-TOA! 🧠  '; ...
                '  Picture the triangle “opening up” like a fan — that opposite side’s gonna stretch out! 🪭  '; ...
                '  SOH CAH TOA — it is the TOA one. 🙈  '; ...
                '  sin(θ) = opposite/hypotenuse ➗  '; ...
            }, ...
            'VariableNames', {'Question', 'Image', 'CorrectAns', 'Solution', 'Hint'});
        
                end
        
        % DISPLAY QUESTION
        function loadQuestion(app)
            q = app.QuestionBank(app.CurrQi, :);

            app.CurrQ.Text = q.Question{1};

            appFolder = fileparts(mfilename('fullpath'));
            imgPath = fullfile(appFolder, 'images', q.Image{1});

                
                
            if ~isempty(q.Image{1}) && isfile(imgPath)
                app.CurrImage.ImageSource = imgPath;
                app.CurrImage.Visible = "on";
            else
                app.CurrImage.Visible = "off";
            end

                
            app.SolutionPanel.Visible = "off";
                
        end
        
        
   end


            
       

    % Callbacks that handle component events
    methods (Access = private)

        % Menu selected function: PythagoreanTheoremMenu
        function PythagoreanTheoremMenuSelected(app, event)

            app.messageLabel.Text = ' Taking you to Lesson Mode: Pythagorean Theorem... 📚';
            app.messageLabel.BackgroundColor = [1.00 0.95 0.85];
            pause(2.0);
            app.messageLabel.Text = '';
         
            TRIGLESSON();

            delete(app);
            
        end

        % Button pushed function: Next
        function NextButtonPushed(app, event)
            app.CurrQi = app.CurrQi + 1;

            % Loop back to first question if at the end
            if app.CurrQi > height(app.QuestionBank)
                app.CurrQi = 1;
            end
        
            loadQuestion(app);
            app.UserAnswer.Value='';
            app.Feedback.Text = '';
        end

        % Button pushed function: Hint
        function HintButtonPushed(app, event)
            app.HintDispMain.BackgroundColor = [1 1 1];
            app.HintDisp_mini1.BackgroundColor = [1 1 1];
            app.HintDisp_mini2.BackgroundColor = [1 1 1];

            uistack(app.HintDispMain, 'top');
            uistack(app.HintDisp_mini1, 'top');
            uistack(app.HintDisp_mini2, 'top');

            hint = app.QuestionBank.Hint{app.CurrQi};

            app.HintDispMain.Text = hint;

            pause(3.0);

            app.HintDispMain.Text = '';
            app.HintDisp_mini1.BackgroundColor = 'none';
            app.HintDisp_mini2.BackgroundColor = 'none';
            app.HintDispMain.BackgroundColor = 'none';


            
        end

        % Button pushed function: ShowSolution
        function ShowSolutionButtonPushed(app, event)
            
            if strcmp(app.SolutionPanel.Visible, "on")
                % Hide 
                app.SolutionPanel.Visible = "off";
                app.ShowSolution.Text = 'Show Solution 🔍';
                app.ExplainTxt.Text = '';
                app.Answer.Text = '';

            else
    
                % Show 
                app.SolutionPanel.Visible = "on";
                app.ExplainTxt.Text = app.QuestionBank.Solution(app.CurrQi);
                app.Answer.Text = app.QuestionBank.CorrectAns(app.CurrQi);
                app.ShowSolution.Text = 'Hide Solution 🔍';
            end


        end

        % Button pushed function: Previous
        function PreviousButtonPushed(app, event)
            if app.CurrQi > 1
                app.CurrQi = app.CurrQi - 1;
                loadQuestion(app); 
            end
        end

        % Button pushed function: BEGINButton
        function BEGINButtonPushed(app, event)
          delete(app.Panel);
          
          app.LivesLeft = 3;
          app.LeftLamp.Color = [0.43,1.00,0.65];      
          app.MiddleLap.Color = [0.43,1.00,0.65];   
          app.RightLamp.Color = [0.43,1.00,0.65]; 
          app.UserAnswer.Value = '';

          app.qBank()

          app.LeftLamp.Visible="on";
          app.MiddleLap.Visible="on";
          app.RightLamp.Visible="on";
          app.LampLabel.Visible ="on";
          app.QuestionPanel.Visible="on";
          app.Next.Visible="on";
          app.Previous.Visible="on";
          app.ShowSolution.Visible="on";
          app.Hint.Visible="on";
          app.CheckAnswer.Visible="on";

          app.CurrQi = 1;
          loadQuestion(app);
        end

        % Button pushed function: CheckAnswer
        function CheckAnswerButtonPushed(app, event)
            answer = app.UserAnswer.Value;

             if isempty(answer)
                app.Feedback.Text = ' Oops! You forgot to enter an answer!';
                app.Feedback.FontColor = [0.85, 0.33, 0.10];
                return;
             end

             correct_ans = app.QuestionBank.CorrectAns{app.CurrQi};

            if strcmp(answer, correct_ans)
                app.Feedback.Text = ' Correct! Good work!';
                app.Feedback.FontColor = [0.22,0.65,0.44];
            else
                app.Feedback.Text = ' Not quite! Try again!';
                app.Feedback.FontColor = [0.81,0.07,0.40];
                loseLife(app);
            end

           
        end

        % Button pushed function: RestartButton
        function RestartButtonPushed(app, event)
            BEGINButtonPushed(app);
            app.LivesLostPanel.Visible="off";
            uistack(app.LivesLostPanel, 'bottom');
        end

        % Button pushed function: LessonButton
        function LessonButtonPushed(app, event)
            app.QuizModeLabel.Text = ' Taking you to Lessons... 📚';
            app.QuizModeLabel.BackgroundColor = [0.96 0.47 0.16];
            pause(2.0);
            app.QuizModeLabel.Text = '';
          
            LESSONMODEMAIN();

            delete(app);
            
        end
    end

    % Component initialization
    methods (Access = private)

        % Create UIFigure and components
