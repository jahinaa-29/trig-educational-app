classdef TRIGLESSON < matlab.apps.AppBase

    % Properties that correspond to app components
    properties (Access = public)
        UIFigure                        matlab.ui.Figure
        Menu                            matlab.ui.container.Menu
        LessonModeMenu                  matlab.ui.container.Menu
        TrigonometricFunctionsMenu      matlab.ui.container.Menu
        PracticeModeMenu                matlab.ui.container.Menu
        QuizModeLabel                   matlab.ui.control.Label
        CHEATSHEETButton                matlab.ui.control.Button
        CheatSheet                      matlab.ui.container.Panel
        NOTESLabel                      matlab.ui.control.Label
        NOTESLabel_4                    matlab.ui.control.Label
        NOTESLabel_3                    matlab.ui.control.Label
        NOTESLabel_2                    matlab.ui.control.Label
        AngleBEditField                 matlab.ui.control.NumericEditField
        AngleAEditField                 matlab.ui.control.NumericEditField
        SideBEditField                  matlab.ui.control.NumericEditField
        SideAEditField                  matlab.ui.control.NumericEditField
        DrawDefault345TriangleButton    matlab.ui.control.Button
        DragthesliderstomakeyourowntriangleLabel  matlab.ui.control.Label
        PLAYGROUNDLabel                 matlab.ui.control.Label
        Image                           matlab.ui.control.Image
        SideACHypotenuseEditField       matlab.ui.control.NumericEditField
        SideACHypotenuseEditFieldLabel  matlab.ui.control.Label
        Button_6                        matlab.ui.control.Button
        AngleBSlider                    matlab.ui.control.Slider
        AngleBSliderLabel               matlab.ui.control.Label
        Button_5                        matlab.ui.control.Button
        AngleASlider                    matlab.ui.control.Slider
        AngleASliderLabel               matlab.ui.control.Label
        SideBCSlider                    matlab.ui.control.Slider
        SideBCSliderLabel               matlab.ui.control.Label
        Button_4                        matlab.ui.control.Button
        Button_3                        matlab.ui.control.Button
        Button                          matlab.ui.control.Button
        SideABSlider                    matlab.ui.control.Slider
        SideABSliderLabel               matlab.ui.control.Label
        Button_2                        matlab.ui.control.Button
        PYTHAGOREANTHEOREMLabel         matlab.ui.control.Label
        UIAxes                          matlab.ui.control.UIAxes
    end

    
    methods (Access = private)
        function updateTriangle(app, aVal, bVal)
            sF = 2.5; % image scaling
            
            % Use passed-in slider values instead of reading from UI components
            a = aVal * sF;
            b = bVal * sF;
            
            c = sqrt(a^2 + b^2);
            
            % Calculate angles
            angleA = atand(a / b);
            angleB = 90 - angleA;
            
            % Update angle sliders and hypotenuse field
            app.AngleASlider.Value = angleA;
            app.AngleBSlider.Value = angleB;

            app.SideACHypotenuseEditField.Enable = "off";
            app.SideAEditField.Enable = "off";
            app.SideBEditField.Enable = "off";
       
            app.AngleAEditField.Enable = "off";
            app.AngleBEditField.Enable = "off";

            app.SideACHypotenuseEditField.Value = round(c / sF, 2);

            app.SideAEditField.Value = aVal;
            app.SideBEditField.Value = bVal;

            app.AngleAEditField.Value = app.AngleASlider.Value;
            app.AngleBEditField.Value = app.AngleBSlider.Value;

            
            % Clear and redraw the triangle
            cla(app.UIAxes)
            hold(app.UIAxes, 'on')

           % --------------------------DRAW AND LABEL----------------------------%

            % Font settings for labels
            labelFont = 'Yuanti SC';
            labelSize = 24;
            paddingX = 1;
            paddingY = 1;

            
            % Plot side A (vertical)
            plot(app.UIAxes, [0 0], [0 a], 'LineWidth', 3, 'Color', '#37a771')
            
            % Plot side B (horizontal)
            plot(app.UIAxes, [0 b], [0 0], 'LineWidth', 3, 'Color', '#f7b11a')
            
            % Plot hypotenuse (side C)
            plot(app.UIAxes, [b 0], [0 a], 'LineWidth', 3, 'Color', '#7f6ff2')
            
            % Plot vertices with markers
            plot(app.UIAxes, [0 b 0], [0 0 a], 'o', 'MarkerSize', 6, 'MarkerFaceColor', '#555555')
            

            % Coordinates of vertices
            vertexA = [0, 0];     % Bottom-left
            vertexB = [b, 0];     % Bottom-right
            vertexC = [0, a];     % Top-left
            
            % Add text labels

            text(app.UIAxes, vertexA(1), vertexA(2), 'A', ...
                'FontSize', 20, 'FontName', labelFont, ...
                'Color', '#f781e9', 'HorizontalAlignment', 'right', 'VerticalAlignment', 'top');
            
            text(app.UIAxes, vertexB(1), vertexB(2), 'B', ...
                'FontSize', 20, 'FontName', labelFont, ...
                'Color', '#ff771d', 'HorizontalAlignment', 'left', 'VerticalAlignment', 'top');
            
            text(app.UIAxes, vertexC(1), vertexC(2) + 0.5, 'C', ...
                'FontSize', 20, 'FontName', labelFont, ...
                'Color', '#086fcf', 'HorizontalAlignment', 'center', 'VerticalAlignment', 'bottom');

            
               axis(app.UIAxes, 'equal');
                padding = 3;
                maxX = b + padding;
                maxY = a + padding;
                xlim(app.UIAxes, [-padding, max(maxX, 10)]);
                ylim(app.UIAxes, [-padding, max(maxY, 10)]);
                grid(app.UIAxes, 'on');
                app.UIAxes.Box = 'on';
                app.UIAxes.XColor = [0.3 0.3 0.3];
                app.UIAxes.YColor = [0.3 0.3 0.3];
                app.UIAxes.Color = [1 1 1];
            
            
            % Label Side A (vertical)
            midAC = [0, a/2];
            text(app.UIAxes, midAC(1) - paddingX, midAC(2), 'AB   ', ...
                'FontSize', labelSize, 'FontName', labelFont, ...
                'Color', '#37a771', 'HorizontalAlignment', 'center')
            
            % Label Side B (horizontal)
            midAB = [b/2, 0];
            text(app.UIAxes, midAB(1), midAB(2) - paddingX, 'BC', ...
                'FontSize', labelSize, 'FontName', labelFont, ...
                'Color', '#f7b11a', 'HorizontalAlignment', 'center')
            
            % Label Side C (hypotenuse)
            midBC = [b/2, a/2];
            text(app.UIAxes, midBC(1) + paddingX, midBC(2) + paddingY, '   AC', ...
                'FontSize', labelSize, 'FontName', labelFont, ...
                'Color', '#7f6ff2', 'HorizontalAlignment', 'center')
        end

        
        

    end


        methods (Access = private)

        % Create UIFigure and components 
    end

    methods (Access = private)
        % Startup function runs right after UI components are created, before user sees app
    end
    

    % Callbacks that handle component events
    methods (Access = private)

        % Value changed function: SideABSlider
        function SideABSliderValueChanged(app, event)
           app.SideBCSlider.Enable = "on"; 
           app.AngleASlider.Enable = "on";
           app.AngleBSlider.Enable = "on";

        end

        % Value changing function: SideBCSlider
        function SideBCSliderValueChanging(app, event)
            % only lets user change SIDE B component at a time
            app.SideABSlider.Enable = "off"; 
            app.AngleASlider.Enable = "off";
            app.AngleBSlider.Enable = "off";
            
            app.updateTriangle(app.SideABSlider.Value, event.Value);
            
        end

        % Value changing function: SideABSlider
        function SideABSliderValueChanging(app, event)
            % only lets user change SIDE A component at a time
            app.SideBCSlider.Enable = "off"; 
            app.AngleASlider.Enable = "off";
            app.AngleBSlider.Enable = "off";
            
            app.updateTriangle(event.Value, app.SideBCSlider.Value);
            
        end

        % Value changed function: SideBCSlider
        function SideBCSliderValueChanged(app, event)
           app.SideABSlider.Enable = "on"; 
           app.AngleASlider.Enable = "on";
           app.AngleBSlider.Enable = "on";
        end

        % Button pushed function: DrawDefault345TriangleButton
        function DrawDefault345TriangleButtonPushed(app, event)
            app.SideABSlider.Value = 3;
            app.SideBCSlider.Value = 4;
            app.updateTriangle(3,4);
        end

        % Value changing function: AngleASlider
        function AngleASliderValueChanging(app, event)
            % Disable other sliders
            app.SideABSlider.Enable = "off";
            app.SideBCSlider.Enable = "off";
            app.AngleBSlider.Enable = "off";
        
            % Get the new angleA
            angleA = event.Value;
        
            % Define base unit side and scale factor
            sideA = app.SideABSlider.Value;
        
            % Calculate sideB
            sideB = sideA / tand(angleA);
        
            % Scale both sides for visibility
        
            % Update the triangle drawing
            app.updateTriangle(sideA, sideB);

            app.SideABSlider.Enable = "on";
            app.SideBCSlider.Enable = "on";
            app.AngleBSlider.Enable = "on";

            
        end

        % Value changed function: AngleASlider
        function AngleASliderValueChanged(app, event)

            % Update angle B
            angleA = app.AngleASlider.Value;
            app.AngleBSlider.Value = 90 - angleA;
        
            
        end

        % Value changing function: AngleBSlider
        function AngleBSliderValueChanging(app, event)
            % Disable other sliders
            app.SideABSlider.Enable = "off";
            app.SideBCSlider.Enable = "off";
            app.AngleASlider.Enable = "off";
        
            % Get the new angleA
            angleB = event.Value;
        
            % Define base unit side and scale factor
            sideA = app.SideABSlider.Value;
        
            % Calculate sideB
            sideB = sideA / tand(angleB);
        
            % Scale both sides for visibility
        
            % Update the triangle drawing
            app.updateTriangle(sideA, sideB);

            app.SideABSlider.Enable = "on";
            app.SideBCSlider.Enable = "on";
            app.AngleBSlider.Enable = "on";
            
        end

        % Value changed function: AngleBSlider
        function AngleBSliderValueChanged(app, event)
            % Update angle A
            angleB = app.AngleBSlider.Value;
            app.AngleASlider.Value = 90 - angleB;
        
            
        end

        % Button pushed function: CHEATSHEETButton
        function CHEATSHEETButtonPushed(app, event)
            if strcmp(app.CheatSheet.Visible, "on")
                % close 
                app.CheatSheet.Visible = "off";
                
            else
    
                % open 
                app.CheatSheet.Visible = "on";
               
            end

        end

        % Menu selected function: PracticeModeMenu
        function PracticeModeMenuSelected(app, event)
            app.QuizModeLabel.Text = ' Taking you to Practice Mode... 📝';
            app.QuizModeLabel.BackgroundColor = [0.96 0.47 0.16];
            pause(2.0);
            app.QuizModeLabel.Text = '';
          
            TRIGQUIZ();

            delete(app);
        end

        % Menu selected function: TrigonometricFunctionsMenu
        function TrigonometricFunctionsMenuSelected(app, event)
            app.QuizModeLabel.Text = ' Taking you to Lesson Mode: Trigonometric Functions... 📚';
            app.QuizModeLabel.BackgroundColor = [0.96 0.47 0.16];
            pause(2.0);
            app.QuizModeLabel.Text = '';
          
            TRIG_FUNC();

            delete(app);
        end
    end

    % Component initialization
