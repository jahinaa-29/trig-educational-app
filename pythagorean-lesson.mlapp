            app.NOTESLabel_2.HorizontalAlignment = 'center';
            app.NOTESLabel_2.WordWrap = 'on';
            app.NOTESLabel_2.FontName = 'Yuanti SC';
            app.NOTESLabel_2.FontSize = 18;
            app.NOTESLabel_2.FontWeight = 'bold';
            app.NOTESLabel_2.FontColor = [0.0667 0.4431 0.7451];
            app.NOTESLabel_2.Position = [1 97 389 29];
            app.NOTESLabel_2.Text = '📐 TYPES OF TRIANGLES BY ANGLES 📐';

            % Create NOTESLabel_3
            app.NOTESLabel_3 = uilabel(app.CheatSheet);
            app.NOTESLabel_3.WordWrap = 'on';
            app.NOTESLabel_3.FontName = 'Yuanti SC';
            app.NOTESLabel_3.FontSize = 18;
            app.NOTESLabel_3.FontColor = [1 1 1];
            app.NOTESLabel_3.Position = [15 14 331 66];
            app.NOTESLabel_3.Text = {'• Acute: All angles < 90°'; '• Right: One angle = 90'; '• Obtuse: One angle > 90°'};

            % Create NOTESLabel_4
            app.NOTESLabel_4 = uilabel(app.CheatSheet);
            app.NOTESLabel_4.BackgroundColor = [1 0.9098 0.3922];
            app.NOTESLabel_4.HorizontalAlignment = 'center';
            app.NOTESLabel_4.WordWrap = 'on';
