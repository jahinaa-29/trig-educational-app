            app.NOTESLabel_4.Position = [1 283 389 29];
            app.NOTESLabel_4.Text = '🔺 GENERAL PROPERTIES 🔺';

            % Create NOTESLabel
            app.NOTESLabel = uilabel(app.CheatSheet);
            app.NOTESLabel.WordWrap = 'on';
            app.NOTESLabel.FontName = 'Yuanti SC';
            app.NOTESLabel.FontSize = 18;
            app.NOTESLabel.FontColor = [1 1 1];
            app.NOTESLabel.Position = [15 141 374 133];
            app.NOTESLabel.Text = {'• Sum of angles in any triangle = 180°'; '    >>>  A + B + C = 180°'; '• A triangle must have the sum of any two sides > third side'; ''; '• PYTHAGOREAN: AC² = AB² + BC²'; ''};

            % Create CHEATSHEETButton
            app.CHEATSHEETButton = uibutton(app.UIFigure, 'push');
            app.CHEATSHEETButton.ButtonPushedFcn = createCallbackFcn(app, @CHEATSHEETButtonPushed, true);
            app.CHEATSHEETButton.BackgroundColor = [0.1608 0.349 0.749];
            app.CHEATSHEETButton.FontName = 'Yuanti SC';
            app.CHEATSHEETButton.FontSize = 24;
